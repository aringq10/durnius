root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

[*.{bat,cmd}]
end_of_line = crlf

[*.cs]
indent_size = 4
#### .NET coding conventions ####
dotnet_sort_system_directives_first = true
dotnet_style_namespace_declarations = file_scoped:suggestion
dotnet_style_require_accessibility_modifiers = always_for_non_interface_members:suggestion

# var — matches the existing majority style
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning

# braces — the codebase mostly uses them; the exceptions can be auto-fixed
csharp_prefer_braces = true:warning

# modern C# style (matches the applied refactors)
dotnet_style_prefer_collection_expression = true:warning
csharp_style_prefer_primary_constructors = true:warning
csharp_style_deconstructed_variable_declaration = true:warning
csharp_style_prefer_tuple_swap = true:warning

#### Naming rules (order matters — more specific first) ####

# constants → PascalCase
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

# private/internal fields → _camelCase
dotnet_naming_rule.private_fields_should_be_underscore.severity = warning
dotnet_naming_rule.private_fields_should_be_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore.style = underscore_camel

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, protected_internal, internal

# enum members → PascalCase
dotnet_naming_rule.enum_members_should_be_pascal_case.severity = warning
dotnet_naming_rule.enum_members_should_be_pascal_case.symbols = enum_members
dotnet_naming_rule.enum_members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.enum_members.applicable_kinds = enum
dotnet_naming_symbols.enum_members.applicable_members = members

#### Naming styles ####
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

# EF Core migrations are machine-generated — skip analyzers/formatting there
[**/Migrations/**.cs]
generated_code = true
