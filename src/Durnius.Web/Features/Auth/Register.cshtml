@model Durnius.Web.Features.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<div class="card">
    <h2>Register</h2>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <div class="field">
            <label asp-for="Username"></label><br />
            <input asp-for="Username" />
            <span asp-validation-for="Username" class="error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label><br />
            <input asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="error"></span>
        </div>

        <button type="submit">Register</button>
    </form>

    <p class="links">
        Already have an account? <a asp-action="Login">Log In</a>
    </p>
</div>
