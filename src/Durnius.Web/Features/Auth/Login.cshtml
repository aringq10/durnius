@model Durnius.Web.Features.Auth.LoginViewModel

@{
    ViewData["Title"] = "Log In";
    Layout = "_Layout";
}

<div class="card">
    <h2>Log In</h2>

    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="error"></div>

        <div class="field">
            <label asp-for="Username"></label><br />
            <input asp-for="Username" />
            <span asp-validation-for="Username" class="error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label><br />
            <input asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="error"></span>
        </div>

        <div class="field">
            <label>
                <input asp-for="RememberMe" /> @Html.DisplayNameFor(m => m.RememberMe)
            </label>
        </div>

        <button type="submit">Log In</button>
    </form>

    <p class="links">
        No account yet? <a asp-action="Register">Register</a>
    </p>
</div>
