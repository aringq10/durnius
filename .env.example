# Host port the API is published on (also the port the dev client calls).
PORT=8080

POSTGRES_USER=durnius
POSTGRES_PASSWORD=
POSTGRES_DB=durnius

# JWT signing settings. JWT_KEY must be at least 32 characters for HMAC-SHA256.
JWT_KEY=
JWT_ISSUER=durnius
JWT_AUDIENCE=durnius-client
JWT_EXPIRY_MINUTES=60
